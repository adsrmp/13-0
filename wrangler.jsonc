{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirteen-0",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // The game page and anything else in /public is served as static files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // GameRoom: one Durable Object per live room. Leaderboard: one Durable Object holding every board.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "SCORES", "class_name": "Leaderboard" }
    ]
  },
  // SQLite-backed Durable Objects are what the Workers free plan supports.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Leaderboard"] }
  ],
  "observability": { "enabled": true }
}
