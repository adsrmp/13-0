{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thirteen-0",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // The game page and anything else in /public is served as static files.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // One Durable Object per live room.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  // SQLite-backed Durable Objects are what the Workers free plan supports.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "observability": { "enabled": true }
}
